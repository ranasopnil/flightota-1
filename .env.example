# Copy to .env.local. NEXT_PUBLIC_* values are inlined at build time.

# Canonical site URL (metadata, sitemap, share links, image optimisation of /uploads)
NEXT_PUBLIC_SITE_URL=https://flightota.com
# Public API gateway shown in docs and code samples
NEXT_PUBLIC_GATEWAY_URL=https://api.flightota.com
# Base URL used by the browser (RTK Query) for catalog and lead requests; defaults to /api/v1,
# which the web server routes to the admin backend.
# NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-side: when set, Server Components read the catalog and all editable
# content from the admin backend instead of the bundled data in src/content.
API_INTERNAL_URL=http://127.0.0.1:4000/v1
# Shared with the admin backend; lets it refresh cached pages after an edit.
REVALIDATE_SECRET=change-me
